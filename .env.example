# Copy to .env and adjust. Never commit .env.
#
# Read by the agent and the MCP server, from the working directory you run them
# in, and by Compose. A variable you have already exported wins over this file,
# so `FOO=bar node dist/main.js` still overrides it.

# --- Graph -------------------------------------------------------------------
# Local Docker FalkorDB. On FalkorDB Cloud use the connection string from the
# console instead; nothing else changes, the same code path is used either way.
FALKORDB_URL=redis://localhost:6379
# Host ports for the Compose stack. Change FALKORDB_PORT if something else on
# your machine already owns 6379; then point FALKORDB_URL at the same port.
# FALKORDB_BROWSER_PORT is the graph browser, the same one as http://localhost:3000.
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
# One graph per repository. Use a fresh name to index from scratch.
NEXUS_GRAPH=nexus
# Changing the salt changes every id in the graph. Set it once, then leave it.
NEXUS_SALT=default

# --- Identity ----------------------------------------------------------------
# Memory is scoped by user and repository: recall only ever returns what the
# same user learned in the same repository.
NEXUS_USER=local
NEXUS_AGENT=nexus-agent

# --- The repository to index -------------------------------------------------
# Required by the MCP server. The agent also takes it as --root.
NEXUS_ROOT=/absolute/path/to/repository

# --- Model provider ----------------------------------------------------------
# Claude is the default. Set NEXUS_PROVIDER only to choose a different one:
# anthropic | openai | google | ollama | openai-compatible | stub
# The stub provider is scripted and never reaches the network: it exists so the
# whole tool loop can be run and tested without a key.
NEXUS_PROVIDER=anthropic
NEXUS_MODEL=claude-sonnet-4-5

# Whichever provider is selected needs its key; a missing key fails fast at
# startup and names the variable rather than falling back to another model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google's SDK reads GOOGLE_GENERATIVE_AI_API_KEY.
GOOGLE_GENERATIVE_AI_API_KEY=
# A local or self-hosted OpenAI-compatible endpoint. This one is not an override:
# it *is* the openai-compatible provider. Setting it with no NEXUS_PROVIDER selects
# that provider, and NEXUS_MODEL then says which model it serves. It stays commented
# out of the default setup so that copying this file does not change the provider.
# NEXUS_BASE_URL=http://localhost:11434/v1

# Optional endpoint overrides, one per provider, for a proxy or gateway. Include the
# version prefix each provider expects: /v1 for Anthropic and OpenAI, /v1beta for
# Google. Set only the one belonging to the provider in use; a URL set for another
# provider warns at startup instead of being ignored in silence.
# ANTHROPIC_BASE_URL=https://gateway.example/v1
# OPENAI_BASE_URL=https://gateway.example/v1
# GEMINI_BASE_URL=https://gateway.example/v1beta

# --- The agent's test runner -------------------------------------------------
# Off unless this is exactly "1". When on, the agent may run the workspace test
# command for the test files it asks for — one fixed command, no shell, paths
# that must stay inside the repository.
NEXUS_ALLOW_TESTS=
