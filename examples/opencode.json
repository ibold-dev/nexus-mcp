{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nexus": {
      "type": "local",
      "command": ["node", "/absolute/path/to/nexus-mcp/packages/mcp/dist/main.js"],
      "enabled": true,
      "environment": {
        "NEXUS_ROOT": "/absolute/path/to/the/repository/you/are/working/in",
        "FALKORDB_URL": "redis://localhost:6379",
        "NEXUS_GRAPH": "nexus",
        "NEXUS_SALT": "change-me",
        "NEXUS_USER": "you",
        "NEXUS_AGENT": "opencode"
      }
    }
  }
}
